# Production environment variables
DEBUG=False
SECRET_KEY=django-temp-key-change-me-in-real-production-$(openssl rand -base64 32)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database configuration (matching docker-compose.yml)
USE_POSTGRES=True
DB_NAME=blog_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Email configuration
EMAIL_USER=
EMAIL_PASS=

# OpenAI API Key for blog summarization (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Django Log Level
DJANGO_LOG_LEVEL=INFO

# Security Settings
SECURE_SSL_REDIRECT=False
